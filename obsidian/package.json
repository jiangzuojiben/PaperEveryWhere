{
  "name": "vaultdesk",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Independent local vault application with self-hosted sync and publishing",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node scripts/start-desktop.mjs",
    "test": "node --test tests/*.test.mjs",
    "package:win": "npm run build && node scripts/package-windows.mjs",
    "test:cloud": "python -m pytest tests/cloud_test.py -q"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "dompurify": "^3.2.6",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.6.0",
    "moment": "2.31.0",
    "path-browserify": "1.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "42.11.9",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "local.vaultdesk.desktop",
    "productName": "VaultDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "core/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  }
}
