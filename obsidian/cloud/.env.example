# Copy settings into your shell or compose environment. No credentials are needed
# until you register an account through the desktop app or API.
VAULTDESK_DB=./cloud/data/vaultdesk.sqlite3
VAULTDESK_ALLOW_REGISTRATION=true
VAULTDESK_MAX_FILE_BYTES=16777216
VAULTDESK_USER_QUOTA_BYTES=1073741824
VAULTDESK_HISTORY_QUOTA_BYTES=5368709120
VAULTDESK_SESSION_TTL_SECONDS=2592000
VAULTDESK_CORS_ORIGINS=http://localhost:5178,http://127.0.0.1:5178
