  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "extract",
              "ask",
              "summarize",
              "translate",
              "figure",
              "figures",
              "ocr"
            ],
            "title": "Kind"
          },
          "paper_id": {
            "type": "string",
            "maxLength": 200,
            "title": "Paper Id"
          },
          "file_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Hash"
          },
          "question": {
            "type": "string",
            "maxLength": 20000,
            "title": "Question",
            "default": ""
          },
          "pages": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Pages"
          },
          "image_base64": {
            "type": "string",
            "maxLength": 8000000,
            "title": "Image Base64",
            "default": ""
          },
          "target_language": {
            "type": "string",
            "maxLength": 100,
            "title": "Target Language",
            "default": "简体中文"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "paper_id"
        ],
        "title": "JobInput"
      },
      "PairInput": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 100,
            "minLength": 32,
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "PairInput"
      },
      "ProviderInput": {
        "properties": {
          "endpoint": {
            "type": "string",
            "maxLength": 1000,
            "title": "Endpoint"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model"
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          }
        },
        "type": "object",
        "required": [
          "endpoint",
          "model"
        ],
        "title": "ProviderInput"
      },
      "UploadResolution": {
        "properties": {
          "keep_existing": {
            "type": "boolean",
            "title": "Keep Existing"
          }
        },
        "type": "object",
        "required": [
          "keep_existing"
        ],
        "title": "UploadResolution"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VersionSelection": {
        "properties": {
          "pdf_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Pdf Id"
          }
        },
        "type": "object",
        "required": [
          "pdf_id"
        ],
        "title": "VersionSelection"
      },
      "WriteInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "annotation",
              "note",
              "progress"
            ],
            "title": "Kind"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "base_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Revision"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "kind",
          "data"
        ],
        "title": "WriteInput"
      }
    }
  }
}
